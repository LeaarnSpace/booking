# Copy to .env.local and fill in. Never commit real values.

# Public address of the booking app (used for sign-in redirects and local file links)
BETTER_AUTH_URL=http://localhost:4500
# Random 32+ character string, different from the back office's: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google sign-in for customers. Use its own Google Cloud project/OAuth client (audience "External"),
# not the back office's. Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave empty to offer emailed codes only. At least one of Google or email must be set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accounts on these domains count as staff: they see staff-only spaces and book for free, confirmed straight
# away. Comma-separated, e.g. learnspace.com.ng,learnspace.africa
BOOKING_STAFF_EMAIL_DOMAINS=
# Minutes a requested slot is held while the customer pays and uploads a receipt (default 1440 = 24 hours)
BOOKING_HOLD_MINUTES=

# Leave both empty locally to use postgres://postgres@localhost:5432/learnspace.
# Production (Neon): DATABASE_POOLED_URL = the pooled URL (host contains "-pooler"), used by the running app;
# DATABASE_DIRECT_URL = the direct URL, used only for migrations (`npm run db:migrate`).
DATABASE_POOLED_URL=
DATABASE_DIRECT_URL=
# Optional: keep booking data (and customer accounts) in a separate database (default: the two above)
BOOKING_DATABASE_POOLED_URL=
BOOKING_DATABASE_DIRECT_URL=

# Email (sign-in codes and booking emails). Locally: console (printed in the server log) or mailpit
# (http://localhost:8025). Production: gmail through Google Workspace (no extra cost, 2,000 a day; see
# SETUP.local.md for the service account), with brevo as a backup (free plan: 300 a day) if Gmail fails.
# Optional: leave EMAIL_DRIVER empty in production to switch email off; customers then sign in with Google only
# (so Google must be set up) and get no booking emails.
EMAIL_DRIVER=console
EMAIL_BACKUP_DRIVER=
MAILPIT_URL=
# The service account's client_email and private_key, and the Workspace mailbox it sends as. EMAIL_FROM_ADDRESS
# must be that mailbox or one of its "Send mail as" aliases.
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY=
GMAIL_SENDER=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=bookings@learnspace.com.ng
EMAIL_FROM_NAME=Learn Space

# Where customers pay the commitment fee (shown on the payment page)
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=

# Support details shown on the Support page and in the footer
SUPPORT_EMAIL=info@learnspace.com.ng
SUPPORT_PHONE=
SUPPORT_ADDRESS=38, Diya Street, Gbagada, Lagos

# File storage: payment receipts (private) and space photos (public). Same settings as the back office.
# Locally, leave these empty: files go to .storage at the repo root, shared with the back office.
STORAGE_DRIVER=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_RECEIPTS_BUCKET=
STORAGE_MEDIA_BUCKET=
STORAGE_MEDIA_PUBLIC_URL=

# The back office calls this app to clear its cached spaces, services, prices and photos (POST /api/revalidate)
# and to send emails and Slack posts after staff decisions (POST /api/outbox). The same value as the back
# office's: `openssl rand -base64 32`. Leave empty locally.
BOOKING_APP_SECRET=
# Address of the back office, for the links in Slack posts
BACKOFFICE_URL=

# Emails and Slack posts are sent once, straight after the change they're about. One that fails is kept as failed
# (the back office shows it, under Bookings → Notifications) and not tried again, unless this allows more tries
# (0–7, default 0). Retries only happen when the app is sending anyway: nothing runs on a schedule.
MESSAGE_RETRIES=

# Slack posts for staff. Locally: printed in the server log. Production: slack, with an Incoming Webhook
# (Slack app → Incoming Webhooks → Add New Webhook to Workspace). Leave CHAT_DRIVER empty to post nothing.
CHAT_DRIVER=
SLACK_WEBHOOK_URL=
