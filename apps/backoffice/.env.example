# Copy to .env.local and fill in. Never commit real values.

# Public address of the back office (used for sign-in redirects)
BETTER_AUTH_URL=http://localhost:4400
# Random 32+ character string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client ID, type "Web")
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google accounts on these domains can sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=learnspace.com.ng
# These people become managers of every section on first sign-in (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=

# Leave both empty locally to use postgres://postgres@localhost:5432/learnspace.
# Production (Neon): DATABASE_POOLED_URL = the pooled URL (host contains "-pooler"), used by the running app;
# DATABASE_DIRECT_URL = the direct URL, used only for migrations (`npm run db:migrate`).
DATABASE_POOLED_URL=
DATABASE_DIRECT_URL=
# Optional: keep staff accounts in a separate database (default: the two above)
STAFF_DATABASE_POOLED_URL=
STAFF_DATABASE_DIRECT_URL=


# Bookings. Booking-app accounts on any of these domains count as staff: free bookings, confirmed straight
# away. A list, comma-separated, e.g. learnspace.com.ng,learnspace.africa (default: ALLOWED_EMAIL_DOMAINS)
BOOKING_STAFF_EMAIL_DOMAINS=
# Minutes a requested slot is held while waiting for the receipt (default 1440 = 24 hours), how much
# "Extend hold" adds (default 30), and how close to expiry a hold is flagged (default 60)
BOOKING_HOLD_MINUTES=
BOOKING_HOLD_EXTEND_MINUTES=
BOOKING_HOLD_WARN_MINUTES=

# File storage: payment receipts (private) and room photos (public).
# Locally, leave these empty: files go to .storage at the repo root (shared with the booking app) and each
# app serves them itself.
# Production on Cloudflare R2: STORAGE_DRIVER=s3, the R2 S3 API endpoint and an R2 API token (Object Read & Write,
# limited to these two buckets). Any S3-compatible provider works the same way.
STORAGE_DRIVER=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_RECEIPTS_BUCKET=
STORAGE_MEDIA_BUCKET=
# Public address of the media bucket (an R2 custom domain such as media.learnspace.com.ng)
STORAGE_MEDIA_PUBLIC_URL=xxxxx

# The booking app, which the back office tells when staff change something there: refresh its cached spaces,
# services, prices and photos, and send the emails and Slack posts a booking decision queued. BOOKING_APP_SECRET:
# `openssl rand -base64 32`, the same value in both apps. Leave empty locally (the booking app doesn't cache in
# development); without them the booking app catches up later (within 15 minutes for the catalog, at its next
# change or daily job for messages).
BOOKING_APP_URL=
BOOKING_APP_SECRET=
