# Copy to .env.local and fill in. Never commit real values.

# Public address of the back office (used for sign-in redirects)
BETTER_AUTH_URL=http://localhost:4400
# Random 32+ character string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client ID, type "Web")
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google accounts on these domains can sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=learnspace.com.ng
# These people become managers of every section on first sign-in (comma-separated)
BOOTSTRAP_ADMIN_EMAILS=

# Leave both empty locally to use postgres://postgres@localhost:5432/learnspace.
# Production (Neon): DATABASE_URL = the pooled URL (host contains "-pooler"), used by the running app;
# DATABASE_URL_UNPOOLED = the direct URL, used only for migrations (`npm run db:migrate`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: keep staff accounts in a separate database (default: the two above)
STAFF_DATABASE_URL=
STAFF_DATABASE_URL_UNPOOLED=

# Local development only: sign in with a 6-digit code sent by email (no passwords anywhere).
# Codes go to Mailpit at http://localhost:8025. Ignored in production.
DEV_EMAIL_SIGN_IN=false
# Outgoing email (defaults to Mailpit on this machine)
SMTP_URL=
MAIL_FROM=Learn Space <no-reply@learnspace.com.ng>
